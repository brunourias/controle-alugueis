rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Administração global da plataforma. Troque este e-mail se o responsável mudar.
    function platformAdmin() {
      return request.auth != null &&
        request.auth.token.email == "brunourias@gmail.com";
    }

    function signedIn() {
      return request.auth != null;
    }

    // Uma conta aprovada pode criar sua área. Contas antigas com perfil
    // preservado continuam ativas quando o modo de aprovação é habilitado.
    function approvedAccount() {
      return signedIn() && (
        platformAdmin() ||
        (
          !exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        ) ||
        (
          exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.status == "approved"
        )
      );
    }

    function personalWorkspace(workspaceId) {
      return approvedAccount() && workspaceId == "personal-" + request.auth.uid;
    }

    function member(workspaceId) {
      return approvedAccount() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function role(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function owner(workspaceId) {
      return member(workspaceId) && role(workspaceId) == "owner";
    }

    function manager(workspaceId) {
      return member(workspaceId) && (role(workspaceId) == "owner" || role(workspaceId) == "admin");
    }

    function writer(workspaceId) {
      return member(workspaceId) &&
        (role(workspaceId) == "owner" || role(workspaceId) == "admin" || role(workspaceId) == "operator" || role(workspaceId) == "billing" || role(workspaceId) == "finance");
    }

    function invitedRole(value) {
      return value == "admin" || value == "operator" || value == "billing" || value == "finance" || value == "viewer";
    }

    // Solicitação de acesso: a própria conta cria e lê somente a sua;
    // apenas a administração global lista, aprova ou recusa.
    // Catálogo, assinaturas e auditoria são exclusivos da administração global.
    match /platformPlans/{planId} {
      allow read, write: if platformAdmin();
    }

    match /platformAudit/{entryId} {
      allow read, create: if platformAdmin();
      allow update, delete: if false;
    }

    match /accessRequests/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || platformAdmin());
      allow list: if platformAdmin();
      allow create: if platformAdmin() || (signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "pending");
      allow update, delete: if platformAdmin();
    }

    match /users/{userId} {
      allow read, write: if approvedAccount() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || platformAdmin();
      allow create: if approvedAccount() && request.auth.uid == userId;
      allow update: if (approvedAccount() && request.auth.uid == userId) || platformAdmin();
    }

    match /workspaces/{workspaceId} {
      allow create: if personalWorkspace(workspaceId) &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if owner(workspaceId) ||
        (personalWorkspace(workspaceId) &&
          request.resource.data.ownerId == request.auth.uid);
      allow delete: if owner(workspaceId);
      allow read: if member(workspaceId) || personalWorkspace(workspaceId);

      match /members/{memberId} {
        allow get: if member(workspaceId) &&
          (memberId == request.auth.uid || manager(workspaceId)) ||
          (personalWorkspace(workspaceId) && memberId == request.auth.uid);
        allow list: if manager(workspaceId);

        allow create, update: if
          (personalWorkspace(workspaceId) &&
            memberId == request.auth.uid &&
            request.resource.data.role == "owner") ||
          manager(workspaceId) ||
          (approvedAccount() &&
            memberId == request.auth.uid &&
            invitedRole(request.resource.data.role) &&
            request.resource.data.inviteId is string &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)) &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.status == "pending" &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role);

        allow delete: if manager(workspaceId) && resource.data.role != "owner";
      }

      match /invites/{inviteId} {
        allow create, delete: if manager(workspaceId);
        allow list: if manager(workspaceId);
        allow get: if manager(workspaceId) ||
          (approvedAccount() && resource.data.status == "pending" && resource.data.expiresAt > request.time);
        allow update: if manager(workspaceId) ||
          (approvedAccount() &&
            resource.data.status == "pending" &&
            resource.data.expiresAt > request.time &&
            request.resource.data.status == "accepted" &&
            request.resource.data.acceptedBy == request.auth.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "acceptedBy", "acceptedAt"]) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)));
      }

      match /state/{stateId} {
        allow read, create, update: if owner(workspaceId);
        allow delete: if false;
      }

      match /meta/{metaId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if writer(workspaceId);
      }

      match /units/{unitId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if writer(workspaceId);

        match /contracts/{contractId} {
          allow read: if member(workspaceId);
          allow create, update, delete: if writer(workspaceId);
        }
      }

      match /expenses/{expenseId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if writer(workspaceId);
      }

      match /{document=**} {
        allow read, write: if personalWorkspace(workspaceId);
      }
    }
  }
}
