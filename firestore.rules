rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Uma conta só pode inicializar/reparar a área com o seu próprio UID.
    function personalWorkspace(workspaceId) {
      return signedIn() && workspaceId == "personal-" + request.auth.uid;
    }

    function member(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function role(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function owner(workspaceId) {
      return member(workspaceId) && role(workspaceId) == "owner";
    }

    function manager(workspaceId) {
      return member(workspaceId) && (role(workspaceId) == "owner" || role(workspaceId) == "admin");
    }

    function writer(workspaceId) {
      return member(workspaceId) &&
        (role(workspaceId) == "owner" || role(workspaceId) == "admin" || role(workspaceId) == "operator");
    }

    function invitedRole(value) {
      return value == "admin" || value == "operator" || value == "viewer";
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      // A conta pode sempre configurar apenas sua própria área pessoal.
      // Nenhum outro workspace recebe esta exceção.
      allow create: if personalWorkspace(workspaceId) &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if owner(workspaceId) ||
        (personalWorkspace(workspaceId) &&
          request.resource.data.ownerId == request.auth.uid);
      allow delete: if owner(workspaceId);
      allow read: if member(workspaceId) || personalWorkspace(workspaceId);

      match /members/{memberId} {
        // Necessário para o primeiro login e restrito ao próprio vínculo.
        allow get: if member(workspaceId) &&
          (memberId == request.auth.uid || manager(workspaceId)) ||
          (personalWorkspace(workspaceId) && memberId == request.auth.uid);
        allow list: if manager(workspaceId);

        // Primeiro proprietário ou colaborador aceitando um convite.
        allow create, update: if
          (personalWorkspace(workspaceId) &&
            memberId == request.auth.uid &&
            request.resource.data.role == "owner") ||
          manager(workspaceId) ||
          (signedIn() &&
            memberId == request.auth.uid &&
            invitedRole(request.resource.data.role) &&
            request.resource.data.inviteId is string &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)) &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.status == "pending" &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role);

        allow delete: if manager(workspaceId) && resource.data.role != "owner";
      }

      match /invites/{inviteId} {
        allow create, delete: if manager(workspaceId);
        allow list: if manager(workspaceId);
        allow get: if manager(workspaceId) ||
          (signedIn() && resource.data.status == "pending" && resource.data.expiresAt > request.time);
        allow update: if manager(workspaceId) ||
          (signedIn() &&
            resource.data.status == "pending" &&
            resource.data.expiresAt > request.time &&
            request.resource.data.status == "accepted" &&
            request.resource.data.acceptedBy == request.auth.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "acceptedBy", "acceptedAt"]) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)));
      }

      // Mantém o formato anterior somente como contingência de migração.
      match /state/{stateId} {
        allow read, create, update: if owner(workspaceId);
        allow delete: if false;
      }

      match /meta/{metaId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if writer(workspaceId);
      }

      match /units/{unitId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if writer(workspaceId);

        match /contracts/{contractId} {
          allow read: if member(workspaceId);
          allow create, update, delete: if writer(workspaceId);
        }
      }

      match /expenses/{expenseId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if writer(workspaceId);
      }
    }
  }
}
