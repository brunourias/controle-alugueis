rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Administração global da plataforma. Troque este e-mail se o responsável mudar.
    function platformAdmin() {
      return request.auth != null &&
        request.auth.token.email == "brunourias@gmail.com";
    }

    function signedIn() {
      return request.auth != null;
    }

    // Uma conta aprovada pode criar sua área. Contas antigas com perfil
    // preservado continuam ativas quando o modo de aprovação é habilitado.
    function approvedAccount() {
      return signedIn() && (
        platformAdmin() ||
        (
          !exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.invitedOnly != true
        ) ||
        (
          exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.status == "approved"
        )
      );
    }

    // Contas antigas sem documento de assinatura seguem ativas. Para contas
    // gerenciadas pela plataforma, overdue e canceled bloqueiam escrita também
    // fora do aplicativo (por REST, SDK ou console do navegador).
    function subscriptionWritable() {
      return platformAdmin() || (
        approvedAccount() && (
          !exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid)) ||
          (
            get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.subscriptionStatus != "overdue" &&
            get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.subscriptionStatus != "canceled"
          )
        )
      );
    }

    function personalWorkspace(workspaceId) {
      return approvedAccount() && workspaceId == "personal-" + request.auth.uid;
    }

    // Um colaborador convidado não precisa de assinatura própria: basta ter
    // autenticação e ser membro da área. Ele não ganha, com isso, uma área pessoal.
    function member(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function workspaceSubscriptionWritable(workspaceId) {
      return platformAdmin() || (
        member(workspaceId) && (
          !exists(/databases/$(database)/documents/accessRequests/$(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId)) ||
          (
            get(/databases/$(database)/documents/accessRequests/$(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId)).data.subscriptionStatus != "overdue" &&
            get(/databases/$(database)/documents/accessRequests/$(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId)).data.subscriptionStatus != "canceled"
          )
        )
      );
    }

    function role(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function owner(workspaceId) {
      return member(workspaceId) && role(workspaceId) == "owner";
    }

    function hasRole(workspaceId, first, second, third, fourth, fifth) {
      return member(workspaceId) && (
        role(workspaceId) == first ||
        role(workspaceId) == second ||
        role(workspaceId) == third ||
        role(workspaceId) == fourth ||
        role(workspaceId) == fifth
      );
    }

    function manager(workspaceId) {
      return workspaceSubscriptionWritable(workspaceId) &&
        hasRole(workspaceId, "owner", "admin", "__none__", "__none__", "__none__");
    }

    // Dono, administrador e operador são os únicos que podem alterar
    // unidades, contratos e configurações estruturais.
    function contractManager(workspaceId) {
      return workspaceSubscriptionWritable(workspaceId) &&
        hasRole(workspaceId, "owner", "admin", "operator", "__none__", "__none__");
    }

    // Financeiro também pode registrar pagamentos; Cobrança pode efetuar baixa
    // e acompanhar inadimplência, mas nenhum dos dois altera contratos.
    function paymentOperator(workspaceId) {
      return workspaceSubscriptionWritable(workspaceId) &&
        hasRole(workspaceId, "owner", "admin", "operator", "billing", "finance");
    }

    function collectionOperator(workspaceId) {
      return workspaceSubscriptionWritable(workspaceId) &&
        hasRole(workspaceId, "owner", "admin", "operator", "billing", "__none__");
    }

    function expenseOperator(workspaceId) {
      return workspaceSubscriptionWritable(workspaceId) &&
        hasRole(workspaceId, "owner", "admin", "operator", "finance", "__none__");
    }

    // Cobrança pode gravar o histórico de contato, mas não as demais
    // configurações da área. Financeiro não escreve configurações.
    function metadataManager(workspaceId) {
      return contractManager(workspaceId);
    }

    function billingMetadataUpdate(workspaceId) {
      return collectionOperator(workspaceId) &&
        role(workspaceId) == "billing" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["operationHistory", "versionedBackups"]);
    }

    // A parcela está dentro do documento da unidade. Estas listas explicitam
    // os únicos campos que Financeiro/Cobrança podem mudar, impedindo que uma
    // baixa de pagamento vire alteração de contrato por SDK ou REST.
    function paymentFieldsOnly(workspaceId) {
      return paymentOperator(workspaceId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "paidLate", "lateLedger", "paymentHistory"]);
    }

    function collectionFieldsOnly(workspaceId) {
      return collectionOperator(workspaceId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["chargeLog"]);
    }

    function invitedRole(value) {
      return value == "admin" || value == "operator" || value == "billing" ||
        value == "finance" || value == "viewer";
    }

    // Solicitação de acesso: a própria conta cria e lê somente a sua;
    // apenas a administração global lista, aprova ou recusa.
    // Catálogo, assinaturas e auditoria são exclusivos da administração global.
    match /platformPlans/{planId} {
      allow read, write: if platformAdmin();
    }

    match /platformAudit/{entryId} {
      allow read, create: if platformAdmin();
      allow update, delete: if false;
    }

    match /accessRequests/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || platformAdmin());
      allow list: if platformAdmin();
      allow create: if platformAdmin() || (signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "pending");
      allow update, delete: if platformAdmin();
    }

    match /users/{userId} {
      allow read, write: if approvedAccount() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || platformAdmin();
      // O perfil de um convidado só pode nascer no mesmo lote que aceita
      // um convite válido para o seu próprio e-mail.
      allow create: if (approvedAccount() && request.auth.uid == userId) ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.invitedOnly == true &&
          request.resource.data.acceptedWorkspaceId is string &&
          request.resource.data.acceptedInviteId is string &&
          existsAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.acceptedWorkspaceId)/members/$(userId)) &&
          getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.acceptedWorkspaceId)/invites/$(request.resource.data.acceptedInviteId)).data.status == "accepted" &&
          getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.acceptedWorkspaceId)/invites/$(request.resource.data.acceptedInviteId)).data.acceptedBy == userId &&
          get(/databases/$(database)/documents/workspaces/$(request.resource.data.acceptedWorkspaceId)/invites/$(request.resource.data.acceptedInviteId)).data.email == request.auth.token.email);
      allow update: if (approvedAccount() && request.auth.uid == userId) || platformAdmin();
    }

    match /workspaces/{workspaceId} {
      allow create: if subscriptionWritable() && personalWorkspace(workspaceId) &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if (subscriptionWritable() && owner(workspaceId)) ||
        (subscriptionWritable() && personalWorkspace(workspaceId) &&
          request.resource.data.ownerId == request.auth.uid);
      allow delete: if subscriptionWritable() && owner(workspaceId);
      allow read: if member(workspaceId) || personalWorkspace(workspaceId);

      match /members/{memberId} {
        allow get: if member(workspaceId) &&
          (memberId == request.auth.uid || manager(workspaceId)) ||
          (personalWorkspace(workspaceId) && memberId == request.auth.uid);
        allow list: if manager(workspaceId);

        allow create, update: if
          (personalWorkspace(workspaceId) &&
            memberId == request.auth.uid &&
            request.resource.data.role == "owner") ||
          manager(workspaceId) ||
          (signedIn() &&
            memberId == request.auth.uid &&
            invitedRole(request.resource.data.role) &&
            request.resource.data.inviteId is string &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)) &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.status == "pending" &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email);

        allow delete: if manager(workspaceId) && resource.data.role != "owner";
      }

      match /invites/{inviteId} {
        allow create, delete: if manager(workspaceId);
        allow list: if manager(workspaceId);
        // O convidado só lê o documento se estiver autenticado com o e-mail
        // exato do convite. O token, sozinho, nunca libera dados.
        allow get: if manager(workspaceId) ||
          (signedIn() && resource.data.status == "pending" &&
            resource.data.expiresAt > request.time &&
            resource.data.email == request.auth.token.email);
        allow update: if manager(workspaceId) ||
          (signedIn() &&
            resource.data.status == "pending" &&
            resource.data.expiresAt > request.time &&
            resource.data.email == request.auth.token.email &&
            request.resource.data.status == "accepted" &&
            request.resource.data.acceptedBy == request.auth.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.email == resource.data.email &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "acceptedBy", "acceptedAt"]) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)));
      }

      match /state/{stateId} {
        allow read: if owner(workspaceId);
        allow create, update: if subscriptionWritable() && owner(workspaceId);
        allow delete: if false;
      }

      match /meta/{metaId} {
        allow read: if member(workspaceId);
        allow create, delete: if metadataManager(workspaceId);
        allow update: if metadataManager(workspaceId) || billingMetadataUpdate(workspaceId);
      }

      match /units/{unitId} {
        allow read: if member(workspaceId);
        allow create, delete: if contractManager(workspaceId);
        allow update: if contractManager(workspaceId) ||
          paymentFieldsOnly(workspaceId) || collectionFieldsOnly(workspaceId);

        match /contracts/{contractId} {
          allow read: if member(workspaceId);
          allow create, update, delete: if contractManager(workspaceId);
        }
      }

      match /expenses/{expenseId} {
        allow read: if member(workspaceId);
        allow create, update, delete: if expenseOperator(workspaceId);
      }

      match /{document=**} {
        allow read: if personalWorkspace(workspaceId);
        allow write: if personalWorkspace(workspaceId) && subscriptionWritable();
      }
    }
  }
}
